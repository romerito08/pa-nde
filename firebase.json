{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "paonde-app",
          "appId": "1:76673791229:android:44b14a22b5fe978134fa94",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "paonde-app",
          "configurations": {
            "android": "1:76673791229:android:44b14a22b5fe978134fa94",
            "ios": "1:76673791229:ios:bd4ceb9da1f4bfd234fa94",
            "macos": "1:76673791229:ios:bd4ceb9da1f4bfd234fa94",
            "web": "1:76673791229:web:44342bd915d3b49a34fa94",
            "windows": "1:76673791229:web:7b1d19ac7c177b6334fa94"
          }
        }
      },
      "ios": {
        "default": {
          "projectId": "paonde-app",
          "appId": "1:76673791229:ios:bd4ceb9da1f4bfd234fa94",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "paonde-app",
          "appId": "1:76673791229:ios:bd4ceb9da1f4bfd234fa94",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
